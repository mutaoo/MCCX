<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MccX_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MccX_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MccX_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 连接参数栏 -->
        <Grid Grid.Row="0" ColumnSpacing="8" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="服务器" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Grid.Row="0"
                     Text="{x:Bind ViewModel.ServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="140"
                     PlaceholderText="地址或域名" />

            <TextBlock Grid.Column="2" Grid.Row="0" Text="端口" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" Grid.Row="0"
                     Text="{x:Bind ViewModel.ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="25565" />

            <TextBlock Grid.Column="4" Grid.Row="0" Text="用户名" VerticalAlignment="Center" />
            <TextBox Grid.Column="5" Grid.Row="0"
                     Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="离线玩家名" />

            <TextBlock Grid.Column="6" Grid.Row="0" Text="版本" VerticalAlignment="Center" />
            <TextBox Grid.Column="7" Grid.Row="0"
                     Text="{x:Bind ViewModel.MinecraftVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="auto" />

            <Button Grid.Column="8" Grid.Row="0"
                    Content="连接"
                    Command="{x:Bind ViewModel.ConnectCommand}" />
            <Button Grid.Column="9" Grid.Row="0"
                    Content="断开"
                    Command="{x:Bind ViewModel.DisconnectCommand}" />

            <TextBlock Grid.Column="0" Grid.Row="1"
                       Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- 日志 -->
        <ListView Grid.Row="1"
                  x:Name="LogList"
                  ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:LogEntry">
                    <TextBlock Text="{x:Bind Text}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 命令栏 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="CommandBox"
                     Text="{x:Bind ViewModel.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="聊天或 MCC 命令（/ 开头为内部命令），回车发送"
                     KeyDown="CommandBox_KeyDown" />
            <Button Grid.Column="1"
                    Content="发送"
                    Command="{x:Bind ViewModel.SendCommand}" />
            <Button Grid.Column="2"
                    Content="清空日志"
                    Command="{x:Bind ViewModel.ClearLogCommand}" />
        </Grid>
    </Grid>
</Page>
