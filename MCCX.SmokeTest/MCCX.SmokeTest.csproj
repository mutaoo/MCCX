<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      与 MCCX.App 对齐到同一个 Windows TFM（原来写 net10.0-windows）：
      两边对 Windows SDK 投影的解析必须一致，否则容易出现"只在测试工程能编"的问题。
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCCX.SmokeTest</RootNamespace>
    <SelfContained>false</SelfContained>
    <AssemblyName>MCCX.SmokeTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCCX.Core\MCCX.Core.csproj" />
  </ItemGroup>
</Project>
