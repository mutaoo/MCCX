<Project>
  <!--
    版本号单一来源：MCCX.App（主程序）与 MCCX.Launcher（包根启动器）都导入本文件。
    升 beta 后缀只改 MccxInformationalVersion；升版本主体（如 1.0.2→1.0.3）时两个值一起改。
    界面、README 一律不显示版本号（只在 exe 属性「产品版本」里体现）。
  -->
  <PropertyGroup>
    <MccxVersion>1.0.3</MccxVersion>
    <MccxInformationalVersion>1.0.3.beta.8</MccxInformationalVersion>
  </PropertyGroup>
</Project>
