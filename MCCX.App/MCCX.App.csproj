<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MCCX_App</RootNamespace>
    <!-- 程序名就是 MCCX：exe、进程名、窗口标题都不带前后缀（MCCX.App 只是工程目录名） -->
    <AssemblyName>MCCX</AssemblyName>
    <!--
      版本号（当前 1.0.2.beta.3）：
      - InformationalVersion = 完整版本号，只在 exe 属性「产品版本」里体现，
        界面与 README 均不显示版本号（用户要求，主页保持纯 MCCX 标题）；
      - 文件/程序集版本只取纯数字段 1.0.2（预发布后缀含点与字母，进不了 AssemblyVersion/FileVersion）
      升 beta 后缀只改 InformationalVersion 一处；升版本主体（如 1.0.1→1.0.2）时 Version 同步改。
    -->
    <Version>1.0.2</Version>
    <InformationalVersion>1.0.2.beta.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <!-- Framework-dependent: allows referencing the MCC exe project (NETSDK1150) -->
    <SelfContained>false</SelfContained>
    <!--
      Do NOT auto-set PublishProfile here: importing the pubxml during build forces
      SelfContained=true, which blocks referencing the MCC exe project (NETSDK1150).
      Pass -p:PublishProfile=win-x64 explicitly when publishing.
    -->
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      以免安装（unpackaged）方式运行：不需要 Windows 开发者模式，也无需 MSIX 安装，
      `dotnet run` 直接启动 exe。需要打包发布时再改回 MSIX 并开启开发者模式。
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      自定义 Main（Program.cs）：既负责 WinUI 启动，也承担多开子进程入口
      （MCCX.exe 带 runner 参数启动）。关掉 XAML 编译器生成的入口，避免两个 Main 冲突。
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只保留程序图标；WinUI 模板自带的默认 logo 与裁剪源图已删除 -->
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- MCC core source (single-instance integration) -->
  <ItemGroup>
    <ProjectReference Include="..\MCCSource\MinecraftClient\MinecraftClient.csproj" />
    <ProjectReference Include="..\MCCX.Core\MCCX.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <!--
    版本固定，不用 "*"：浮动版本会让同一份源码在不同时间/不同机器上解析出不同的
    WASDK 与 BuildTools（构建不可复现）。升级时只改这里，并用
    dotnet list MCCX.App package (加 include-transitive) 复核完整解析结果。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    发布属性：
    - PublishTrimmed 一律关闭（原来是 Release=True）。MCC 大量依赖反射：
      Tomlet 配置反序列化、Translations 资源、Roslyn 内存编译脚本、反射式命令注册，
      裁剪会静默剪坏这些功能（能启动、一连就错），这是踩过的坑。
    - PublishReadyToRun 只影响启动速度，不做裁剪，Release 保持开启。
  -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
