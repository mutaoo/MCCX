<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MCCX_App.MobFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MCCX_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MCCX_App.ViewModels"
    mc:Ignorable="d"
    Title="生物过滤"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <!--
        生物过滤弹窗（和“添加账号”一样的模态窗）。
        91 项生物列表塞进参数弹层会被窗口底边裁掉，改整窗展示：里面能滚，
        每个分类自带“展开/收回”按钮，分类标题条与生物列表分两层底色，一眼分得清。
        勾选与模式直接绑定选中账号的 ViewModel：改动立即生效并随账号落盘。
    -->
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--
                    分类条走界面同一套中性灰（蓝/绿等彩调和整体 UI 不搭），
                    生物列表保持白底/近黑底：分类条比列表明显深一档，两层底色一眼分得清。
                -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CategoryHeaderBrush" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="MobListBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CategoryHeaderBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="MobListBrush" Color="#232323" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel Spacing="10" Width="440">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模式：" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="过滤模式"
                      SelectedIndex="{x:Bind VM.AttackFilterModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="不过滤（仅敌对）" />
                <ComboBoxItem Content="白名单（只打勾选的）" />
                <ComboBoxItem Content="黑名单（勾选的不打）" />
            </ComboBox>
        </Grid>

        <TextBlock Text="不过滤=只打敌对生物；白名单=只打勾选的；黑名单=候选生物全打、勾选的跳过。改动立即生效并随账号保存。"
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <!--
            整个内容区再兜一层限高：三类全展开时不至于把弹窗顶出屏幕。
            每个分类的列表自己还有一个 MaxHeight（见下），平时这层不会滚。
        -->
        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <!-- 敌对：默认展开（默认模式就是“不过滤(仅敌对)”） -->
                <Border CornerRadius="4"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Background="{ThemeResource CategoryHeaderBrush}"
                              ColumnSpacing="8"
                              Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 分类右侧的展开/收回按钮：点一下把这一类的生物列表露出来/收起来 -->
                            <ToggleButton x:Name="HostileExpand"
                                          AutomationProperties.Name="敌对展开"
                                          Tag="hostile"
                                          IsChecked="True"
                                          Content="▾"
                                          MinWidth="0"
                                          Padding="6,2"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="展开 / 收起该分类包含的生物"
                                          Checked="CategoryExpand_Changed"
                                          Unchecked="CategoryExpand_Changed" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind VM.AttackFilterHostileHeader}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <CheckBox Grid.Column="2"
                                      AutomationProperties.Name="敌对生物全选"
                                      Content="全选"
                                      MinWidth="0"
                                      Padding="6,2"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind VM.AttackFilterHostileAll, Mode=TwoWay}"
                                      ToolTipService.ToolTip="勾上=这一类全选，取消=这一类全不选" />
                        </Grid>

                        <StackPanel x:Name="HostileList"
                                    Padding="8,4"
                                    Background="{ThemeResource MobListBrush}">
                            <!-- 列表自己限高：41 项不能把下面两个分类标题顶出视野，类内自己滚 -->
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind VM.AttackFilterHostile, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:MobFilterItem">
                                            <CheckBox AutomationProperties.Name="{x:Bind Name}"
                                                      Content="{x:Bind Name}"
                                                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="{x:Bind Key}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 中立：默认收起 -->
                <Border CornerRadius="4"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Background="{ThemeResource CategoryHeaderBrush}"
                              ColumnSpacing="8"
                              Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="NeutralExpand"
                                          AutomationProperties.Name="中立展开"
                                          Tag="neutral"
                                          IsChecked="False"
                                          Content="▸"
                                          MinWidth="0"
                                          Padding="6,2"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="展开 / 收起该分类包含的生物"
                                          Checked="CategoryExpand_Changed"
                                          Unchecked="CategoryExpand_Changed" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind VM.AttackFilterNeutralHeader}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <CheckBox Grid.Column="2"
                                      AutomationProperties.Name="中立生物全选"
                                      Content="全选"
                                      MinWidth="0"
                                      Padding="6,2"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind VM.AttackFilterNeutralAll, Mode=TwoWay}"
                                      ToolTipService.ToolTip="勾上=这一类全选，取消=这一类全不选" />
                        </Grid>

                        <StackPanel x:Name="NeutralList"
                                    Padding="8,4"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource MobListBrush}">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind VM.AttackFilterNeutral, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:MobFilterItem">
                                            <CheckBox AutomationProperties.Name="{x:Bind Name}"
                                                      Content="{x:Bind Name}"
                                                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="{x:Bind Key}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 友好：默认收起 -->
                <Border CornerRadius="4"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Background="{ThemeResource CategoryHeaderBrush}"
                              ColumnSpacing="8"
                              Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="FriendlyExpand"
                                          AutomationProperties.Name="友好展开"
                                          Tag="friendly"
                                          IsChecked="False"
                                          Content="▸"
                                          MinWidth="0"
                                          Padding="6,2"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="展开 / 收起该分类包含的生物"
                                          Checked="CategoryExpand_Changed"
                                          Unchecked="CategoryExpand_Changed" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind VM.AttackFilterFriendlyHeader}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <CheckBox Grid.Column="2"
                                      AutomationProperties.Name="友好生物全选"
                                      Content="全选"
                                      MinWidth="0"
                                      Padding="6,2"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind VM.AttackFilterFriendlyAll, Mode=TwoWay}"
                                      ToolTipService.ToolTip="勾上=这一类全选，取消=这一类全不选" />
                        </Grid>

                        <StackPanel x:Name="FriendlyList"
                                    Padding="8,4"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource MobListBrush}">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind VM.AttackFilterFriendly, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:MobFilterItem">
                                            <CheckBox AutomationProperties.Name="{x:Bind Name}"
                                                      Content="{x:Bind Name}"
                                                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="{x:Bind Key}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
