<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MCCX_App.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="添加账号"
    PrimaryButtonText="添加"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!--
        多开账号的连接信息：服务器、端口、游戏名、版本，外加“是否立刻上线”。
        端口留空 = 连接时按 25565 / DNS SRV 自动解析（与右侧面板行为一致）。
        控件命名用 New* 前缀，避免 AutomationId 与主页面板里的 ServerBox 等重名。
    -->
    <StackPanel Spacing="10" Width="360">
        <TextBox x:Name="NewServerBox"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 Header="服务器"
                 PlaceholderText="IP 或域名（可写 域名:端口）"
                 AutomationProperties.Name="添加服务器" />
        <TextBox x:Name="NewPortBox"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 Header="端口"
                 PlaceholderText="留空 = 25565（域名会先查 SRV）"
                 AutomationProperties.Name="添加端口" />
        <TextBox x:Name="NewUserBox"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 Header="游戏名"
                 PlaceholderText="离线玩家名"
                 AutomationProperties.Name="添加游戏名" />
        <TextBox x:Name="NewVersionBox"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 Header="版本"
                 PlaceholderText="auto"
                 AutomationProperties.Name="添加版本" />
        <CheckBox x:Name="NewAutoConnectBox"
                  Content="立即连接"
                  IsChecked="True"
                  AutomationProperties.Name="立即连接" />
        <TextBlock x:Name="NewErrorBox"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</ContentDialog>
