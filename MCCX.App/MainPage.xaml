                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom" Opened="OnFlyoutOpened" FlyoutPresenterStyle="{StaticResource ParamFlyoutPresenterStyle}">
                                    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" ZoomMode="Disabled" Loaded="FlyoutScroller_Loaded">
                                        <!-- 宽度按 2026-10-21 的新规格（208 = 原来 312 的三分之二）：标签左对齐 + 84 输入列 -->
                                        <StackPanel Spacing="8" Width="192">
                                            <TextBlock Text="进服后持续朝当前朝向前进（自动寻路，遇墙绕行/遇高差会重试）；关掉开关或断开连接即停。"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap" />

                                            <!-- 2026-10-08 需求：每个功能一个独立日志开关（过程日志，状态提示照常推）。
                                                 2026-10-20 起开关控制的是“日志发出”：值下发到子进程，
                                                 Bot 里就不会产生这批过程日志，不再靠界面按文本过滤。 -->
                                            <TextBlock Text="关掉只留开关状态提示"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
