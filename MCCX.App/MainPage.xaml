<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MCCX_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accounts="using:MCCX.Core"
    xmlns:converters="using:MCCX_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MCCX_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MCCX_App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 账号列表为空（右侧无选中账号）时，右侧面板折叠成空白页 -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：多开账号列表（需求 3.1 持久化 / 5. 多账号导航） -->
        <Grid Grid.Column="0"
              Width="250"
              Margin="0,0,16,0"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="账号列表"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="添加账号"
                        AutomationProperties.Name="添加账号"
                        Command="{x:Bind ViewModel.AddAccountCommand}" />
            </StackPanel>

            <ListView Grid.Row="1"
                      x:Name="AccountList"
                      ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                      SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AccountViewModel">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ServerSummary, Mode=OneWay}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2"
                    HorizontalAlignment="Left"
                    Content="删除"
                    Command="{x:Bind ViewModel.DeleteAccountCommand}" />
        </Grid>

        <!-- 右侧：选中账号的窗口（连接面板 + 自动化控制 + 日志控制台）；无账号时整体隐藏 -->
        <Grid Grid.Column="1"
              RowSpacing="10"
              Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                连接参数栏。
                状态文字必须独占一行：否则它的宽度会参与“服务器”所在 Auto 列的列宽计算，
                连上服务器后状态变长（“已连接 host:port”）会把服务器框挤窄、后面所有控件位移。
            -->
            <Grid Grid.Row="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ParamsGrid" Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="服务器" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="ServerBox"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.ServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140"
                             PlaceholderText="地址或域名" />

                    <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3"
                             x:Name="PortBox"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="25565" />

                    <TextBlock Grid.Column="4" Text="用户名" VerticalAlignment="Center" />
                    <TextBox Grid.Column="5"
                             x:Name="UserBox"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="离线玩家名" />

                    <TextBlock Grid.Column="6" Text="版本" VerticalAlignment="Center" />
                    <TextBox Grid.Column="7"
                             x:Name="VersionBox"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.MinecraftVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="auto" />

                    <Button Grid.Column="8"
                            Content="连接"
                            Command="{x:Bind ViewModel.ConnectCommand}" />
                    <Button Grid.Column="9"
                            Content="断开"
                            Command="{x:Bind ViewModel.DisconnectCommand}" />
                </Grid>

                <TextBlock x:Name="StateTextBlock"
                           Grid.Row="1"
                           Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>

            <!-- 自动化控制（需求 3.2）：砍怪 / 鼠标按键 / 钓鱼 / 自动重连 -->
            <Border x:Name="AutomationPanel"
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8">
                <!--
                    功能开关横排；每个功能的参数不再平铺，收进开关旁边的下拉按钮（Flyout）。
                    AutomationProperties.Name 保持与原 UI 一致，自动化测试仍可定位。
                    外面套 ScrollViewer：窗口变窄时横向滚动，而不是把最后面的功能裁掉。
                -->
                <ScrollViewer HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AutomationRow" Orientation="Horizontal" Spacing="14">

                    <!-- 自动砍怪 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="自动砍怪" VerticalAlignment="Center" />
                        <ToggleSwitch AutomationProperties.Name="自动砍怪"
                                      MinWidth="0"
                                      IsOn="{x:Bind ViewModel.AttackEnabled, Mode=TwoWay}" />
                        <DropDownButton AutomationProperties.Name="自动砍怪选项"
                                        ToolTipService.ToolTip="砍怪参数">
                            <!-- DropDownButton 模板本身自带箭头，这里不再重复放 FontIcon -->
                            <DropDownButton.Flyout>
                                <Flyout Opened="OnFlyoutOpened">
                                    <StackPanel Spacing="8" Width="250">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="距离" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="攻击距离"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.AttackRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="冷却下限" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="冷却下限"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.AttackCooldownMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="冷却上限" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="冷却上限"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.AttackCooldownMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Text="冷却取下限~上限之间的随机值（ms），带随机抖动。"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!-- 鼠标按键控制 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="鼠标控制" VerticalAlignment="Center" />
                        <ToggleSwitch AutomationProperties.Name="鼠标控制"
                                      MinWidth="0"
                                      IsOn="{x:Bind ViewModel.MouseEnabled, Mode=TwoWay}" />
                        <DropDownButton AutomationProperties.Name="鼠标控制选项"
                                        ToolTipService.ToolTip="鼠标参数">
                            <!-- DropDownButton 模板本身自带箭头，这里不再重复放 FontIcon -->
                            <DropDownButton.Flyout>
                                <Flyout Opened="OnFlyoutOpened">
                                    <StackPanel Spacing="8" Width="250">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="模式" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.Name="鼠标模式"
                                                      SelectedIndex="{x:Bind ViewModel.MouseModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="长按" />
                                                <ComboBoxItem Content="间隔点击" />
                                                <ComboBoxItem Content="间隔长按" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="按键" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.Name="鼠标按键"
                                                      SelectedIndex="{x:Bind ViewModel.MouseSideIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="左键" />
                                                <ComboBoxItem Content="右键" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="按住 ms" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="按住毫秒"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.MouseHoldMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="间隔 ms" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="间隔毫秒"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.MouseIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="抖动 %" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="抖动百分比"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.MouseJitterPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!-- 自动钓鱼（无参数，不放下拉按钮） -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="自动钓鱼" VerticalAlignment="Center" />
                        <ToggleSwitch AutomationProperties.Name="自动钓鱼"
                                      MinWidth="0"
                                      IsOn="{x:Bind ViewModel.FishingEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 自动重连 -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="自动重连" VerticalAlignment="Center" />
                        <ToggleSwitch AutomationProperties.Name="自动重连"
                                      MinWidth="0"
                                      IsOn="{x:Bind ViewModel.ReconnectEnabled, Mode=TwoWay}" />
                        <DropDownButton AutomationProperties.Name="自动重连选项"
                                        ToolTipService.ToolTip="重连参数">
                            <!-- DropDownButton 模板本身自带箭头，这里不再重复放 FontIcon -->
                            <DropDownButton.Flyout>
                                <Flyout Opened="OnFlyoutOpened">
                                    <StackPanel Spacing="8" Width="250">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="次数" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="重连次数"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.ReconnectAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="间隔 ms" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     AutomationProperties.Name="重连间隔"
                                                     IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False"
                                                     Text="{x:Bind ViewModel.ReconnectDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Text="断线后按次数与间隔自动重连。"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 日志 -->
            <ListView Grid.Row="2"
                      x:Name="LogList"
                      ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:LogEntry">
                        <TextBlock Text="{x:Bind Text}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="12" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 命令栏 -->
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="CommandBox"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         Text="{x:Bind ViewModel.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="聊天或 MCC 命令（/ 开头为内部命令），回车发送"
                         KeyDown="CommandBox_KeyDown" />
                <Button Grid.Column="1"
                        Content="发送"
                        Command="{x:Bind ViewModel.SendCommand}" />
                <Button Grid.Column="2"
                        Content="清空日志"
                        Command="{x:Bind ViewModel.ClearLogCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
