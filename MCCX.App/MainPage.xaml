<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MCCX_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accounts="using:MCCX.Core"
    xmlns:converters="using:MCCX_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MCCX_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MCCX_App.ViewModels"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <!-- 账号列表为空（右侧无选中账号）时，右侧面板折叠成空白页 -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            参数弹层（Flyout）统一外观（2026-10-21 用户要求：窗口太宽、角要圆一点、文本改回左对齐）：
            - 内容宽度按内容定：多数 208（原来 312）、鼠标 224、过滤 228、钓鱼 240，
              输入列同步 114 起收窄（多数 84、鼠标 106、过滤沿用 `*` 填满）；
            - 标签一律左对齐（`[标签列 *][控件列 固定]`），冒号留在标签里；
            - 内边距 10,8、圆角 12；
            - MinWidth 必须写 0：FlyoutPresenter 默认带 FlyoutThemeMinWidth=288，
              不覆盖的话内容再窄窗口也压不下来。
        -->
        <Style x:Key="ParamFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!--
            容器窗口 / 背包面板的蒙板底色（2026-10-16 用户要求：像「添加账号」那样弹一层蒙板）。
            取值同 WinUI ContentDialog 的 smoke（黑 30%，浅色 / 深色主题一样），
            所以观感和「添加账号」那层蒙板是一致的。
        -->
        <SolidColorBrush x:Key="ContainerMaskFill" Color="#4D000000" />

        <!--
            账号列表的两种模板（由代码里的 AccountTemplateSelector 按列表项类型挑）：
            分组打开时列表里混着"组头（AccountGroupHeader）"和"账号（AccountViewModel）"。
        -->
        <DataTemplate x:Key="AccountItemTemplate" x:DataType="viewmodels:AccountViewModel">
            <!-- 悬停时淡入右侧叉号（直接改 Opacity，不改变高度，避免列表项抖动）。
                 Background 必须给 Transparent：没背景的 Grid 空白处不可命中，
                 指针落在行内空白区就收不到 PointerEntered，叉号会不亮。 -->
            <!-- 账号之间加一条分隔线：更直观看出每个账号各自的范围（2026-10-15 需求）。
                 2026-10-16 用户反馈"账号区左右内边距太小、边框顶住文字、看着窄"：
                 给这层 Border 加左右 Padding（只缩内容，分隔线仍占整行），文字比分隔线再往里 6，
                 分隔线不再和文字两头齐平；组头模板 Padding 同步改成 12，保持和账号名对齐。 -->
            <Border BorderThickness="0,0,0,1"
                    Padding="6,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="6"
                  Background="Transparent"
                  PointerEntered="AccountItem_PointerEntered"
                  PointerExited="AccountItem_PointerExited">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{x:Bind DisplayName, Mode=OneWay}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <!-- 连接状态：从项底移到右侧，只留状态词（地址右侧面板状态条里有） -->
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{x:Bind StateBadge, Mode=OneWay}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{x:Bind ServerSummary, Mode=OneWay}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Button Grid.Row="1" Grid.Column="1"
                        x:Name="AccountDeleteButton"
                        AutomationProperties.Name="删除账号"
                        ToolTipService.ToolTip="删除该账号"
                        Content="✕"
                        FontSize="11"
                        MinWidth="0"
                        Padding="6,2"
                        Opacity="0"
                        VerticalAlignment="Center"
                        Click="AccountDelete_Click" />
            </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AccountGroupHeaderTemplate" x:DataType="viewmodels:AccountGroupHeader">
            <!-- 组头：服务器地址 + 账号个数。不可选中（点它没意义），所以 IsHitTestVisible 关掉。
                 左右 Padding 12：和账号项里的文字（项内 Border Padding 6 + ListViewItem Padding 6）对齐。 -->
            <Grid IsHitTestVisible="False"
                  Padding="12,10,12,3"
                  ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind Title, Mode=OneWay}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Count, Mode=OneWay}"
                           FontSize="11"
                           Opacity="0.55"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    <!--
            日志行的右键菜单（2026-10-05 用户要求：去掉底部"复制日志"按钮，
            改成选中文字后右键出现复制）。
            「复制」复制选中的那几个字（没选中就复制整行）。
            「全选」整份日志全选（与 Ctrl+A 同一条逻辑，见 MainPage.Log.cs 的 LogSelectAll）。
            2026-10-09 需求④：去掉「打开链接」——链接统一改为 Ctrl+左键点击跳转，
            并在链接下方画一条下划线作提示（下划线由**每行自带的**覆盖层 Canvas 画，见 MainPage.Log.cs 的 DrawLogLinkUnderlines）。
            2026-10-18：两项都标出快捷键。用 MenuFlyoutItem 内建的 KeyboardAcceleratorTextOverride
            显示（WinUI 的菜单快捷键文本自带"字号小一号、用次要色"的样式，正是要的那一点）。
        -->
        <MenuFlyout x:Key="LogContextMenu">
            <MenuFlyoutItem Text="复制"
                            Click="LogContextCopy_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+C" />
            <MenuFlyoutItem Text="全选"
                            Click="LogContextSelectAll_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+A" />
        </MenuFlyout>
    </Page.Resources>

    <!--
        日志区快捷键（2026-10-18 补）：挂在 Page 上=窗口级，**不要求焦点在日志区**。
        点一下日志行会把焦点给 LogScrollHost，但用户也常见"刚在日志搜索框里打完字、
        焦点还在框里"就去按 Ctrl+C —— 只挂在 LogScrollHost 的 KeyDown 上会收不到。
        焦点在输入框里且框内有选中时让路，交给输入框自己原生复制/全选（见 MainPage.Log.cs）。

        2026-10-18 修：WinUI 对声明了 KeyboardAccelerator 的元素**默认会弹一个快捷键气泡**
        （KeyboardAcceleratorPlacementMode=Auto），我们的 Ctrl+C / Ctrl+A 又是 Page 级=
        到处都能触发，于是日志区里会冒出一个圆角的 "Ctrl+C" 小浮窗，而且这个系统 ToolTip
        一旦卡住就赖在屏幕上不走。把它按上面的 KeyboardAcceleratorPlacementMode="Hidden" 关掉
        （只关提示气泡，快捷键照常生效；右键菜单里的快捷键文字走 KeyboardAcceleratorTextOverride，
        不受这里影响）。
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="LogCopyAccelerator_Invoked" />
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="LogSelectAllAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            左侧：多开账号列表（需求 3.1 持久化 / 5. 多账号导航）。
            整块加底色卡片，和右侧日志区在视觉上分开；底部不再放“删除”按钮，
            删除改为账号项悬停后右侧出现的叉号 + 二次确认弹窗。
        -->
        <Border Grid.Column="0"
                Width="220"
                Margin="0,0,12,0"
                Padding="8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <!-- 第三行：卡片底部的全局设置（暗色模式开关） -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="账号列表"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <!-- 与标题同行、右对齐到账号卡片右边缘：不挤在标题后面，位置固定好找 -->
                    <Button Grid.Column="1"
                            Content="添加账号"
                            AutomationProperties.Name="添加账号"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.AddAccountCommand}" />
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="AccountList"
                          ItemsSource="{x:Bind ViewModel.AccountsView}"
                          SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="0,0,14,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <!--
                        ItemTemplateSelector 在代码里挂（MainPage 构造）：WinUI 3 没有 UWP 的
                        GroupStyle/IGroupable，所以"按服务器分组"是把组头也当成列表项，
                        由 AccountTemplateSelector 按类型选下面两个模板。
                        Padding 右侧留 14 是给浮动滚动条留位，否则它会压住"未连接"那几个字。
                    -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- 内容拉满整行，右侧的状态/叉号才能贴到卡片右边缘 -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!--
                底部一行（2026-10-05 用户要求）：左边是"按服务器分组"按钮，右边是暗色模式开关。
                · 分组：同一台服务器（域名/IP 相同，端口不参与判断）的账号归到一个组，组头显示域名。
                · 暗色开关：不再有"暗色模式"文字（用户要求移除），只留一个月亮/太阳小开关；
                  开（勾选、滑块在右、月亮）= 暗色 #121212，关（滑块在左、太阳）= 浅色；
                  提示文本只显示当前状态（"暗色模式 开 / 关"）。
                两者的状态都写 ui-settings.json，下次启动保持（见 UiSettingsStore / MainWindow.ApplyTheme）。
            -->
                <Grid Grid.Row="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GroupAccountsButton"
                            Grid.Column="0"
                            Content="按服务器分组"
                            AutomationProperties.Name="按服务器分组"
                            FontSize="12"
                            Padding="8,3"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="把同一个服务器的账号归到一个分类里（只看域名/IP，不看端口）"
                            Click="GroupAccountsButton_Click" />
                    <ToggleButton x:Name="ThemeSwitch"
                                  Grid.Column="2"
                                  AutomationProperties.Name="暗色模式切换"
                                  ToolTipService.ToolTip="暗色模式 关"
                                  Click="ThemeSwitch_Click"
                                  Width="46" Height="24"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <!-- 只保留内容，去掉按钮自带外观；视觉全在下面三个具名元素上，
                                     代码里能直接引用（GetTemplateChild 是 protected，页面拿不到）。
                                     配色/图标/滑块位置/提示文本由 ApplyThemeSwitchVisual 按状态改：
                                     勾选 = 开 = 暗色（滑块在右），不勾 = 关 = 浅色（滑块在左）。 -->
                                <ContentPresenter />
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <Grid Width="46" Height="24">
                            <Border x:Name="ThemeSwitchTrack" CornerRadius="12" Background="#333333" />
                            <Ellipse x:Name="ThemeSwitchThumb"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"
                                     Fill="#E8E4D8" />
                            <TextBlock x:Name="ThemeSwitchGlyph"
                                       Text="&#x263E;"
                                       FontSize="11"
                                       Foreground="#1A1A1A"
                                       Width="20" Height="20"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                </Grid>
            </Grid>
        </Border>

        <!-- 右侧：选中账号的窗口（连接面板 + 自动化控制 + 日志控制台）；无账号时整体隐藏 -->
        <Grid Grid.Column="1"
              RowSpacing="10"
              Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <!-- 就一列：连接状态在功能卡片下方单独占一行（贴右），右边不再单开状态列 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- 0 参数行 / 1 功能区卡片 / 2 日志 / 3 命令栏 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                连接参数栏：一行放齐 服务器 / 端口 / 用户名 / 版本 + 连接、断开，标签后面都带冒号。
                服务器给 6* 弹性（下限 160），端口列 92：5 位端口 + 右侧清除按钮（×）才不会把数字盖掉。
                列间距收到 6：标签加冒号要多占一截宽度，从间距里省出来，输入框和按钮一个都不缩小。
                连接状态不占这一块：它在功能卡片下方单独一行、靠右显示。
            -->
            <!-- 上边距 8：左卡片 Padding=8，内容从卡片顶往下 8 起排；这里补同样的 8，
                 参数行就和左侧「账号列表 / 添加账号」同一条水平线（2026-10-15 需求：表单项高度/落差）。 -->
            <Grid x:Name="ParamsGrid" Grid.Row="0" Margin="0,8,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="服务器：" VerticalAlignment="Center" />
                <!-- 2026-10-18 需求：连接中 / 已连接 / 断开中这几个框一律禁用（只有彻底没连时才让改）。
                     只灰掉输入框，「连接 / 断开」两个按钮的可用性由各自命令按状态算。 -->
                <TextBox Grid.Column="1"
                         x:Name="ServerBox"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         IsEnabled="{x:Bind ViewModel.CanEditConnection, Mode=OneWay}"
                         Text="{x:Bind ViewModel.ServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="域名或IP地址" />

                <TextBlock Grid.Column="2" Text="端口：" VerticalAlignment="Center" />
                <TextBox Grid.Column="3"
                         x:Name="PortBox"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         IsEnabled="{x:Bind ViewModel.CanEditConnection, Mode=OneWay}"
                         Text="{x:Bind ViewModel.ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="25565" />

                <TextBlock Grid.Column="4" Text="用户名：" VerticalAlignment="Center" />
                <TextBox Grid.Column="5"
                         x:Name="UserBox"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         IsEnabled="{x:Bind ViewModel.CanEditConnection, Mode=OneWay}"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="离线玩家名" />

                <TextBlock Grid.Column="6" Text="版本：" VerticalAlignment="Center" />
                <!-- 版本：默认 auto，下拉可选常见版本，也能直接手输任意版本号。
                     显式钉死 32：可编辑 ComboBox 默认会被模板撑到 40，比这一行的输入框/按钮高一截
                     （2026-10-15 需求：表单项高度一致）。 -->
                <ComboBox Grid.Column="7"
                          x:Name="VersionBox"
                          IsEditable="True"
                          MinHeight="32"
                          Height="32"
                          VerticalAlignment="Center"
                          IsEnabled="{x:Bind ViewModel.CanEditConnection, Mode=OneWay}"
                          AutomationProperties.Name="版本"
                          PlaceholderText="auto"
                          ToolTipService.ToolTip="auto = 自动探测；也可下拉选或直接输入版本号"
                          Text="{x:Bind ViewModel.MinecraftVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="auto" />
                    <ComboBoxItem Content="26.2" />
                    <ComboBoxItem Content="26.1" />
                    <ComboBoxItem Content="1.21.11" />
                    <ComboBoxItem Content="1.21.9" />
                    <ComboBoxItem Content="1.21.8" />
                    <ComboBoxItem Content="1.21.6" />
                    <ComboBoxItem Content="1.21.4" />
                    <ComboBoxItem Content="1.21.1" />
                    <ComboBoxItem Content="1.20.6" />
                    <ComboBoxItem Content="1.20.4" />
                    <ComboBoxItem Content="1.20.1" />
                    <ComboBoxItem Content="1.19.4" />
                    <ComboBoxItem Content="1.18.2" />
                    <ComboBoxItem Content="1.17.1" />
                    <ComboBoxItem Content="1.16.5" />
                    <ComboBoxItem Content="1.15.2" />
                    <ComboBoxItem Content="1.14.4" />
                    <ComboBoxItem Content="1.13.2" />
                    <ComboBoxItem Content="1.12.2" />
                    <ComboBoxItem Content="1.9.4" />
                    <ComboBoxItem Content="1.8.9" />
                    <ComboBoxItem Content="1.7.10" />
                </ComboBox>

                <!-- 连接/断开 收在行末：整组连接参数一行看完 -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="8">
                    <Button Content="连接"
                            Command="{x:Bind ViewModel.ConnectCommand}" />
                    <Button Content="断开"
                            Command="{x:Bind ViewModel.DisconnectCommand}" />
                </StackPanel>
            </Grid>

            <!-- 自动化控制（需求 3.2）：砍怪 / 鼠标按键 / 钓鱼 / 自动重连 -->
            <Border x:Name="AutomationPanel"
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8">
                <!--
                    功能开关横排；每个功能的参数不再平铺，收进开关旁边的下拉按钮（Flyout）。
                    AutomationProperties.Name 保持与原 UI 一致，自动化测试仍可定位。
                    外面套 ScrollViewer：窗口变窄时横向滚动，而不是把最后面的功能裁掉。
                    底部固定留一截空白（2026-10-04 需求）：横向滚动条出现时叠在这段留白上，
                    不再盖住 / 挤压行内功能文字；不溢出时滚动条不显示，留白只是下边距。
                -->
                <ScrollViewer HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AutomationRow" Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">

                    <!--
                        自动砍怪：标签本身就是下拉按钮——点“自动砍怪”文字即展开参数，
                        DropDownButton 模板自带右侧下拉箭头，悬停时按钮底色变化提示可点开。
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- x:Name：点“生物过滤”开弹窗前要先收起这层参数弹层 -->
                        <DropDownButton x:Name="AttackOptionsButton"
                                        AutomationProperties.Name="自动砍怪选项"
                                        ToolTipService.ToolTip="砍怪参数"
                                        Padding="8,2"
                                        MinWidth="0"
                                        PointerEntered="LabelButton_PointerEntered"
                                        PointerExited="LabelButton_PointerExited">
                            <TextBlock Text="自动砍怪" VerticalAlignment="Center" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom" Opened="OnFlyoutOpened" FlyoutPresenterStyle="{StaticResource ParamFlyoutPresenterStyle}">
