                    <!--
                        自动指令（2026-10-22 需求）：按各自间隔定时把一段文本/指令发进聊天框。
                        · 弹层里可以新建任意多条指令，每条自己的"间隔（秒）"与"进服立即执行"相互独立；
                        · 总开关在卡片上（关掉就整组停），弹层里另有本功能的过程日志开关；
                        · 指令以 / 开头时服务器按指令执行（如 /spawn），否则当聊天发——与命令栏回车同一条路。
                        宽度比别的弹层宽一些：一行要放下"指令输入框 + 删除"和"间隔 + 进服立即执行"。
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <DropDownButton AutomationProperties.Name="自动指令选项"
                                        ToolTipService.ToolTip="自动指令参数：新建/删除指令，每条指令的间隔（秒）与是否进服立即执行"
                                        Padding="8,2"
                                        MinWidth="0"
                                        PointerEntered="LabelButton_PointerEntered"
                                        PointerExited="LabelButton_PointerExited">
                            <TextBlock Text="自动指令" VerticalAlignment="Center" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom" Opened="OnFlyoutOpened" FlyoutPresenterStyle="{StaticResource ParamFlyoutPresenterStyle}">
                                    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" ZoomMode="Disabled" Loaded="FlyoutScroller_Loaded">
                                        <StackPanel Spacing="8" Width="296">
                                            <TextBlock Text="按各自间隔把指令发出去：&#x0a;• / 开头先当 MCC 内部命令（如 /useitem、/send），不是内部命令才当服务器指令（如 /spawn）；不带 / 按聊天发。&#x0a;• 每条可单独设间隔、进服立即执行、执行方式（循环 / 只执行一次）、次数（留空 = 无限）与日志开关。"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap" />

                                            <Button AutomationProperties.Name="新建自动指令"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,6"
                                                    Click="AddAutoCommand_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE710;" />
                                                    <TextBlock Text="新建指令" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!--
                                                指令列表（2026-10-22 第二轮）：每条三行——
                                                  1) 指令框 + 这条自己的日志开关 + 删除 ×
                                                  2) 间隔（秒）+ 这条自己的"进服立即执行"
                                                  3) 执行方式（循环 / 只执行一次）+ 循环次数（只执行一次时整块收起）
                                                输入框都 VerticalAlignment=Center：不跟着 ToggleSwitch 被拉高，
                                                和别的弹层里的输入框一样高（用户反馈"间隔框偏高"）。
                                            -->
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AutoCommands, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:AutoCommandItem">
                                                        <Grid ColumnSpacing="6" RowSpacing="4" Margin="0,0,0,10">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Row="0"
                                                                     Grid.Column="0"
                                                                     VerticalAlignment="Center"
                                                                     AutomationProperties.Name="自动指令文本"
                                                                     IsSpellCheckEnabled="False"
                                                                     IsTextPredictionEnabled="False"
                                                                     PlaceholderText="如 /spawn、/useitem 或 hello"
                                                                     Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ToggleSwitch Grid.Row="0"
                                                                          Grid.Column="1"
                                                                          MinWidth="0"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left"
                                                                          OnContent="日志"
                                                                          OffContent="日志"
                                                                          AutomationProperties.Name="自动指令日志"
                                                                          ToolTipService.ToolTip="这条指令自己的过程日志开关（不影响其它指令）；关掉后指令照发"
                                                                          IsOn="{x:Bind LogEnabled, Mode=TwoWay}" />
                                                            <Button Grid.Row="0"
                                                                    Grid.Column="2"
                                                                    Width="30"
                                                                    Height="30"
                                                                    Padding="0"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="删除自动指令"
                                                                    ToolTipService.ToolTip="删掉这条指令"
                                                                    Click="RemoveAutoCommand_Click"
                                                                    Tag="{x:Bind}">
                                                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE711;" />
                                                            </Button>

                                                            <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="间隔（秒）：" VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Width="64"
                                                                         VerticalAlignment="Center"
                                                                         AutomationProperties.Name="自动指令间隔"
                                                                         IsSpellCheckEnabled="False"
                                                                         IsTextPredictionEnabled="False"
                                                                         PlaceholderText="60"
                                                                         Text="{x:Bind IntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <!--
                                                                    开关文字直接当标签用（开/关两种状态都写同一句）：
                                                                    这行要塞下「间隔（秒）: 64 + 进服立即执行」，再单起一列标签就会被挤成省略号；
                                                                    开关滑块本身已经表示开关状态，文字只当说明。
                                                                -->
                                                                <ToggleSwitch Grid.Column="2"
                                                                              MinWidth="0"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"
                                                                              OnContent="进服立即执行"
                                                                              OffContent="进服立即执行"
                                                                              AutomationProperties.Name="自动指令进服立即执行"
                                                                              ToolTipService.ToolTip="打开：进服（真正进入游戏）后先执行一次这条，之后按上面的方式继续"
                                                                              IsOn="{x:Bind RunOnJoin, Mode=TwoWay}" />
                                                            </Grid>

                                                            <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnSpacing="4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="执行方式：" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1"
                                                                          MinWidth="0"
                                                                          HorizontalAlignment="Stretch"
                                                                          AutomationProperties.Name="自动指令方式"
                                                                          SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}">
                                                                    <ComboBoxItem Content="循环执行" />
                                                                    <ComboBoxItem Content="只执行一次" />
                                                                </ComboBox>
                                                                <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            Spacing="4"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{x:Bind RepeatVisibility, Mode=OneWay}">
                                                                    <TextBlock Text="次数：" VerticalAlignment="Center" />
                                                                    <TextBox Width="64"
                                                                             VerticalAlignment="Center"
                                                                             AutomationProperties.Name="自动指令次数"
                                                                             IsSpellCheckEnabled="False"
                                                                             IsTextPredictionEnabled="False"
                                                                             PlaceholderText="无限"
                                                                             ToolTipService.ToolTip="循环执行的总次数，留空 = 无限；每次进服从 0 重新计数"
                                                                             Text="{x:Bind RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <ToggleSwitch AutomationProperties.Name="自动指令"
                                      MinWidth="0"
                                      IsOn="{x:Bind ViewModel.AutoCommandsEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <!--
                        服务器信息过滤：没有总开关，标签本身就是下拉按钮——
                        过滤方式与两个前缀框都收进弹层（与前面各功能的参数下拉同一套交互，点文字即展开）。
                        只管"服务器发来的消息"进不进日志，Bot 提示和连接提示不受影响；
                        两个前缀类方式各用各的前缀框（2026-10-05 用户要求：
                        "只显示"和"只屏蔽"以前共用一个框，切方式就得重填）。
                    -->
                    <DropDownButton x:Name="ServerFilterOptionsButton"
                                    AutomationProperties.Name="服务器信息过滤选项"
                                    ToolTipService.ToolTip="服务器信息过滤参数：过滤方式 / 两个独立的前缀列表（只影响服务器消息进不进日志，连接提示、Bot 日志不受影响）"
                                    Padding="8,2"
                                    MinWidth="0"
                                    PointerEntered="LabelButton_PointerEntered"
                                    PointerExited="LabelButton_PointerExited">
                        <TextBlock Text="服务器信息过滤" VerticalAlignment="Center" />
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom" Opened="OnFlyoutOpened" FlyoutPresenterStyle="{StaticResource ParamFlyoutPresenterStyle}">
                                <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" ZoomMode="Disabled" Loaded="FlyoutScroller_Loaded">
                                    <StackPanel Spacing="8" Width="228">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="过滤方式：" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.Name="服务器信息过滤"
                                                      MinWidth="0"
                                                      HorizontalAlignment="Stretch"
                                                      SelectedIndex="{x:Bind ViewModel.ServerFilterModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="不过滤" />
                                                <ComboBoxItem Content="全屏蔽" />
                                                <ComboBoxItem Content="屏蔽玩家消息" />
                                                <ComboBoxItem Content="只显示指定前缀" />
                                                <ComboBoxItem Content="只屏蔽指定前缀" />
                                            </ComboBox>
                                        </Grid>
                                        <!-- 两个前缀框各自独立保存：选"只显示指定前缀"只显示上面这个，
                                         选"只屏蔽指定前缀"只显示下面那个（2026-10-05 用户要求互斥显示）。
                                         可见性由 SyncServerFilterRows 按 ServerFilterModeIndex 切。 -->
                                        <Grid x:Name="ServerFilterShowRow" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="只显示：" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1">
                                                <TextBox AutomationProperties.Name="服务器信息只显示前缀"
                                                         IsSpellCheckEnabled="False"
                                                         IsTextPredictionEnabled="False"
                                                         Padding="10,5,34,5"
                                                         PlaceholderText="如 [公告],[活动]"
                                                         Text="{x:Bind ViewModel.ServerFilterShowPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <!-- 右端的展开图标（2026-10-21 需求）：点开多行编辑器写长列表，
                                                     编辑器里一行一个前缀也能认（分隔符加了换行）。 -->
                                                <Button Width="26" Height="26"
                                                        Margin="0,0,3,0"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        CornerRadius="6"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="展开编辑服务器信息只显示前缀"
                                                        ToolTipService.ToolTip="展开成多行编辑（前缀多时可以一行一个）"
                                                        Click="ExpandServerFilterShow_Click">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE740;" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <Grid x:Name="ServerFilterBlockRow" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="只屏蔽：" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1">
                                                <TextBox AutomationProperties.Name="服务器信息只屏蔽前缀"
                                                         IsSpellCheckEnabled="False"
                                                         IsTextPredictionEnabled="False"
                                                         Padding="10,5,34,5"
                                                         PlaceholderText="如 [广告],[spam]"
                                                         Text="{x:Bind ViewModel.ServerFilterBlockPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Width="26" Height="26"
                                                        Margin="0,0,3,0"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        CornerRadius="6"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="展开编辑服务器信息只屏蔽前缀"
                                                        ToolTipService.ToolTip="展开成多行编辑（前缀多时可以一行一个）"
                                                        Click="ExpandServerFilterBlock_Click">
                                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE740;" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="只影响服务器消息进不进日志（连接提示、Bot 日志不受影响）；前缀可多个，用换行/逗号/顿号/竖线分隔，命中任一项即按所选方式处理；留空等于不过滤。点输入框右端的小图标可展开成多行编辑。"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!--
                        玩家背包（2026-10-16 第二轮需求：点功能按钮看当前背包和快捷栏）。
                        点一下开面板（装备 / 背包 / 快捷栏，服务器实时同步），再点一下收起；
                        面板里点格子就是窗口 0 的点击（拿起 / 放下 / 快速移动）。
                        没连服务器时按钮置灰：面板内容来自子进程里的 MCC 会话。
                    -->
                    <Button AutomationProperties.Name="背包"
                            Content="背包"
                            Padding="8,2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            ToolTipService.ToolTip="查看玩家背包、快捷栏与装备（点格子拿起 / 放下，服务器实时同步）"
                            Click="PlayerInventoryButton_Click"
                            PointerEntered="LabelButton_PointerEntered"
                            PointerExited="LabelButton_PointerExited" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--
                2026-10-09 用户定稿（问题③第二轮）：状态与延迟**不再各占一行**，改为一起
                浮在日志区右上角（见下方日志 Grid 里的覆盖层）——之前"状态一行 + 延迟一行"
                把日志整体往下顶了两行，用户明确不要。
                2026-10-09 第三轮反馈"浮窗与功能区间隙过大，缩短一半"：空着的 row2 虽然高 0，
                但 RowSpacing 在它两侧各算一次（10+10），比其它行距翻倍。整行先撤掉（12 DIP）；
                第四轮反馈"还是有点大，再缩短一半"：覆盖层顶边距改成 -4，压进行距带里 ——
                功能卡片底到浮窗顶 = 10 - 4 = 6 DIP，两轮 24 → 12 → 6；
                状态文字顶仍在日志顶之下（logTop + 2 DIP），不破 v_ui7 U7c。
                日志区现在直接是 row2，拿满剩余高度。
            -->

            <!--
                日志区（2026-10-18 起走 D 方案：虚拟化列表，见下方 ItemsRepeater）：
                · 旧版是**一个**撑到内容全高的大只读 TextBox（外层 LogScrollHost 滚动）：选区能跨行、
                  复制很方便，但每来一批日志都要把全文 Text= 重建一次，代价随行数线性上涨
                  （实测 1100 行 393 ms、1 万行 5.3 s、5 万行 73 s）——越用越卡。
                · D 方案：ScrollViewer(LogScrollHost) 里放 **ItemsRepeater**（只实体化可见的行），
                  每行一个只读 TextBox。代价 O(可见)，与总行数无关（实测每次刷新 0.4~1.8 ms）。
                · ScrollViewer 仍显式写出来并命名（LogScrollHost）：外层滚动宿主，
                  "跟随最新一行"和自动化测试的 ScrollPattern 都直接定位它。
                · 行内/跨行选择、Ctrl+点击链接、链接下划线、右键复制、搜索筛选与跳转、
                  贴底跟随与选区暂停，全部按 D 重新实现在 MainPage.Log.cs（那里的注释是权威说明）。
                  指针不落到行 TextBox 上（IsHitTestVisible=False），统一由行外壳接管，
                  这样"跨行选区"不再受单个 TextBox 的边界限制。
                · 2026-10-09 问题③定稿仍然成立：连接状态与延迟**浮在日志区右上角**（不再各占一行
                  把日志往下顶）。覆盖层 IsHitTestVisible=False：点击/框选全部穿透到下面的列表，
                  只是视觉上盖在日志文字上层。
            -->
            <Grid x:Name="LogAreaGrid" Grid.Row="2">
                <ScrollViewer x:Name="LogScrollHost"
                              IsTabStop="True"
                              UseSystemFocusVisuals="False"
                              Loaded="LogScrollHost_Loaded"
                              SizeChanged="LogScrollHost_SizeChanged"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                <!--
                    D 方案（2026-10-18 重写）：外层 ScrollViewer(LogScrollHost) 里放 **ItemsRepeater**
                    （虚拟化，只实体化可见的那些行），每行一个**只读 TextBox**。
                    · 代价与可见行数成正比、与总行数无关（旧版一个大 TextBox 每次全量 Text= 重建，
                      实测 1100 行 393 ms、1 万行 5.3 s、5 万行 73 s，越用越卡）。
                    · 行模板用只读 TextBox 而不是 TextBlock：自动化测试链要靠 Get-RecentLogText
                      收集 "Edit + ValuePattern" 读日志、g_search 靠 TextPattern 读选区；
                      TextBlock 拿不到这一套（会读出一串空串）。
                    · 行 TextBox 关掉命中测试（IsHitTestVisible=False）：指针全部由**行外壳**接管，
                      行内/跨行选区、Ctrl+左键点链接统一在 MainPage.Log.cs 里自己算——
                      这样"跨行选区"不再受单个 TextBox 的边界限制，而且不与原生拖选打架。
                    · 每行自带一层不参与命中测试的 Canvas（画链接下划线与选区高亮），
                      等价于旧版盖在整块日志上的 LinkUnderlineLayer，但改成按行做、随行回收。
                    · 行 TextBox 的 AutomationId 仍是 LogBox：g_search 用它读原生命中选区。
                      Text="…" 走 x:Bind（合并计数"原文 xN"就地刷新时行会自己跟着变）。
                -->
                <Grid>
                    <ItemsRepeater x:Name="LogRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LogEntry">
                                <!--
                                    行外壳：Background=Transparent 才能命中空白区（拖选要拖到行间空白）。
                                    右键菜单（LogContextMenu）挂在行外壳上；指针/右键都在这里接管。
                                -->
                                <Grid x:Name="LogRowRoot"
                                      Background="Transparent"
                                      ContextFlyout="{StaticResource LogContextMenu}"
                                      PointerPressed="LogRow_PointerPressed"
                                      PointerMoved="LogRow_PointerMoved"
                                      PointerReleased="LogRow_PointerReleased"
                                      PointerCanceled="LogRow_PointerCanceled"
                                      PointerCaptureLost="LogRow_PointerCaptureLost"
                                      RightTapped="LogRow_RightTapped">
                                    <TextBox x:Name="LogLineBox"
                                             IsReadOnly="True"
                                             IsHitTestVisible="False"
                                             IsTabStop="False"
                                             AcceptsReturn="False"
                                             MinHeight="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             UseSystemFocusVisuals="False"
                                             TextWrapping="Wrap"
                                             SelectionHighlightColor="Transparent"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Text="{x:Bind Text, Mode=OneWay}"
                                             AutomationProperties.AutomationId="LogBox"
                                             TextChanged="LogLineBox_TextChanged"
                                             SizeChanged="LogLineBox_SizeChanged"
                                             ScrollViewer.HorizontalScrollMode="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollMode="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <!--
                                            聚焦/悬停画刷钉成透明：聚焦瞬间模板会自己刷上聚焦白底 + 强调色描边。
                                            行 TextBox 现在不参与命中测试、也不接受焦点，这一组是保险。
                                        -->
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlFocusBorderBrush" Color="Transparent" />
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Canvas x:Name="LogRowLayer"
                                            IsHitTestVisible="False"
                                            Background="Transparent" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
                </ScrollViewer>

                <!--
                    连接状态 + 延迟：浮在日志区**右上角**（2026-10-09 问题③定稿）。
                    不占布局行——日志区满高，不再被"状态一行 + 延迟一行"往下顶。
                    IsHitTestVisible=False：点击/框选全部穿透到下面的日志列表，纯视觉覆盖。
                    2026-10-09 用户反馈原配色（#99000000 黑底白字）与程序不搭 → 改用与账号卡片、
                    自动化面板同一套主题卡片样式（卡片底 + 卡片描边 + 圆角 8 + 主题文字色），
                    亮/暗色随主题自动切换；实底同样能压住底下的日志文字、保证可读。
                    文案过长只用省略号截自己；延迟没连上时整段隐藏（IsConnected）。
                    2026-10-19 对齐：右边缘与上方功能卡片、连接/断开按钮、日志区右边缘同一条线
                    （原来留了 6 DIP 右缩进，看着比卡片缩进去一截；右下角的日志搜索框一直就是贴右对齐的）。
                    上边距同时归零：浮窗顶边正好落在日志区顶边，与卡片的间距就是网格的 10 DIP。
                -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,0,0"
                        Padding="10,5"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="StateTextBlock"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!--
                    日志搜索（2026-10-14 需求；2026-10-16 改版第二轮）：
                    · 浮在日志区**右下角**（紧贴命令栏右上）。
                    · 搜索框本身宽度 = 命令栏里"发送 + 清空日志"两个按钮加起来的宽度，右边和命令栏右端对齐
                      （2026-10-16 用户要求"同宽更整齐"）；宽度在代码里按按钮实际宽度算，见 CommandBarGrid_SizeChanged。
                    · 匹配数是贴在搜索框**左边**的小徽标，不占搜索框宽度（浮在日志文字上，所以带卡片底 + 描边）；
                      放进框里或摆到框右侧都会把搜索框挤窄或顶出对齐线，只有挪到左边两头都保住。
                    · 只留一层边框：不再套外层卡片 Border，直接用 TextBox 自己的边框，
                      免得"外层卡片 + 框内输入框"叠两层、看着又粗又笨（2026-10-16 用户反馈）。
                    · 放大镜图标和"搜索日志"文字**同高**（图标 18 号，视觉高度≈14 号汉字那个高）、同一条中心线；
                      框里一有字图标就暂时隐藏，清空后再出现（2026-10-16 用户要求，见 LogSearchBox_TextChanged）。
                    · 有搜索词时日志**只显示命中的行**（没命中的暂时不显示，清空搜索立刻恢复整份日志
                      并贴回底部，见 MainPage.Log.cs 的 LogSearchBox_TextChanged / RebuildFilteredLogs）。
                    · 2026-10-16（第三轮）：只在**连上服务器之后**才显示——没连上时和命令栏一起整块收起
                      （日志搜索是配着"发命令"用的，离线没得发；绑定 ViewModel.IsConnected）。
                    · 不插在卡片和日志之间，也不进 LogScrollHost——后者会污染 Get-RecentLogText 读到的整块文本。
                    匹配针对每行 LogEntry.Text 原文（大小写不敏感子串），命中行仍按"行 TextBox"参与 UIA。
                -->
                <Grid x:Name="LogSearchHost"
                      Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 匹配数徽标（贴搜索框左边，浮在日志文字上） -->
                    <Border x:Name="LogSearchCountBadge"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Padding="6,0"
                            CornerRadius="6"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="LogSearchCount"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="" />
                    </Border>

                    <!-- 搜索框本体（宽度在代码里设成"发送 + 清空日志"之和）：
                         图标叠在输入框左侧——TextBox 没内置前置图标，用一层 Grid 叠一个不可命中的
                         FontIcon，靠左边距把文字让开（没字时 Padding 左 26）。
                         Padding 上 4（2026-10-16 用户反馈"文字太靠上"）：TextBox 是拿整条行盒
                         （含 CJK 字形根本不用的下伸部）居中的，汉字墨迹天生就偏上，垫 4 让墨迹落到
                         框中间，正好和放大镜的圆对齐。有字时左 Padding 收到 4（文字顶到左边），
                         都在 LogSearchBox_TextChanged 里切。 -->
                    <Grid x:Name="LogSearchField" Grid.Column="1">
                        <TextBox x:Name="LogSearchBox"
                                 Height="32"
                                 MinWidth="60"
                                 Padding="26,4,4,0"
                                 VerticalContentAlignment="Center"
                                 PlaceholderText="搜索日志"
                                 IsSpellCheckEnabled="False"
                                 IsTextPredictionEnabled="False"
                                 AutomationProperties.Name="日志搜索"
                                 TextChanged="LogSearchBox_TextChanged"
                                 KeyDown="LogSearchBox_KeyDown" />
                        <FontIcon x:Name="LogSearchGlyph"
                                  Glyph="&#xE721;"
                                  FontSize="18"
                                  Margin="8,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>

                <!-- 容器窗口 / 背包面板不在这里：它是盖住功能区与命令栏的蒙板弹窗，见本页末尾的 ContainerMask -->

            </Grid>

            <!-- 命令栏：左“常用命令”下拉、中间输入框、右“发送 / 清空日志”
                 （2026-10-15 需求：日志搜索移到日志区右下角，发送/清空日志留在最右）
                 2026-10-16：监听本行尺寸，把右下角搜索框的宽度对齐到“发送 + 清空日志”两个按钮的合计宽度
                 2026-10-16（第三轮）：没连上服务器时整行收起（连上才显示）——输入框/发送/清空日志离线点了也没用
                 （见 ViewModel.IsConnected 绑定；重新显示时还要把右下角搜索框的宽度重算一次，见 MainPage.xaml.cs）
            -->
            <Grid Grid.Row="3" x:Name="CommandBarGrid" ColumnSpacing="8" SizeChanged="CommandBarGrid_SizeChanged"
                  Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 常用命令：自动记录发过的内部命令，也能手动增删；点一条填进输入框 -->
                <Button Grid.Column="0"
                        x:Name="FrequentCommandsButton"
                        Content="常用命令"
                        AutomationProperties.Name="常用命令"
                        ToolTipService.ToolTip="自动记录用过的命令，可手动添加、删除；点一条填进输入框">
                    <Button.Flyout>
                        <Flyout x:Name="FrequentCommandsFlyout"
                                Opening="OnFrequentFlyoutOpening">
                            <!-- 2026-10-05 用户要求：440 太宽、命令短、显得空旷 → 收到 320；
                                 列表右侧留 14 给浮动滚动条，避免压住命令文字。 -->
                            <StackPanel Width="320" Spacing="4">
                                <TextBlock Text="点一条填进输入框；✕ 删除"
                                           FontSize="11"
                                           Opacity="0.7" />

                                <ListView x:Name="FrequentCommandsList"
                                          MaxHeight="260"
                                          Padding="0,0,12,0"
                                          ItemsSource="{x:Bind ViewModel.FrequentCommands, Mode=OneWay}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="True"
                                          ItemClick="FrequentCommand_Click"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <!-- 行距收紧（用户反馈"太空旷"）：上下内边距 4→2，字号 13 -->
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="6,2" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="accounts:FrequentCommand">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Text}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        MinWidth="0"
                                                        Padding="6,2"
                                                        FontSize="11"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="删除常用命令"
                                                        ToolTipService.ToolTip="删除这条常用命令"
                                                        Click="RemoveFrequentCommand_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock x:Name="FrequentCommandsEmptyHint"
                                           Text="还没有常用命令：发出 / 开头的命令后会自动记录。"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap" />

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewFrequentCommandBox"
                                             PlaceholderText="手动输入一条命令"
                                             IsSpellCheckEnabled="False"
                                             IsTextPredictionEnabled="False"
                                             KeyDown="NewFrequentCommand_KeyDown" />
                                    <Button Grid.Column="1"
                                            Content="添加"
                                            AutomationProperties.Name="添加常用命令"
                                            Click="AddFrequentCommand_Click" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <TextBox Grid.Column="1"
                         x:Name="CommandBox"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         Text="{x:Bind ViewModel.CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="聊天或命令（/xxx 会先匹配 MCC 内部命令，没匹配到就发服务器），回车发送"
                         KeyDown="CommandBox_KeyDown"
                         TextChanged="CommandBox_TextChanged" />

                <!--
                    命令建议浮层（2026-10-14 需求；2026-10-15 改配色）：
                    仅当输入以 / 开头且还没出现空格时出现；候选 = MCC 内部命令（本地静态目录）
                    + 服务器 declare_commands/tab 合并出的命令（子进程推过来的 ServerCommands）。
                    贴在输入框正上方、左边缘和输入框对齐（代码里按 CommandBox 的 X 设 HorizontalOffset）；
                    底色/文字/选中行都取主题资源，浅色和深色下都和背景协调。
                    键盘 ↑/↓ 选择、Tab 填入、Esc 关闭（见 CommandBox_KeyDown）。
                -->
                <Popup x:Name="CommandSuggestionPopup"
                       PlacementTarget="{x:Bind CommandBox}"
                       IsOpen="False"
                       IsLightDismissEnabled="True">
                    <!-- 浮层配色跟随主题：底色用主题实色、加一圈卡片描边，
                         不再用半透明黑压在浅色日志上（原先和背景完全不搭）。 -->
                    <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4,4"
                            MinWidth="220"
                            MaxWidth="520"
                            SizeChanged="CommandSuggestionHost_SizeChanged">
                        <ScrollViewer MaxHeight="300"
                                      AutomationProperties.AutomationId="SuggestionPopupHost"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Disabled">
                            <ItemsControl x:Name="CommandSuggestionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SuggestionItem">
                                        <Border Padding="6,2"
                                                Background="{x:Bind RowBrush}"
                                                PointerPressed="CommandSuggestion_Pressed">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <TextBlock Text="{x:Bind Matched}"
                                                           FontFamily="Consolas"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Rest}"
                                                           FontFamily="Consolas"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <Button Grid.Column="2"
                        x:Name="SendButton"
                        Content="发送"
                        Command="{x:Bind ViewModel.SendCommand}" />
                <Button Grid.Column="3"
                        x:Name="ClearLogButton"
                        Content="清空日志"
                        Command="{x:Bind ViewModel.ClearLogCommand}" />
            </Grid>

            <!--
                容器窗口（2026-10-16 需求：服务器 GUI 里点格子执行操作）+ 玩家背包面板
                （2026-10-16 第二轮需求：点功能区「背包」按钮看当前背包和快捷栏。
                 同日第三轮：服务器窗口要和背包联动，所以窗口下面还会跟着画一块"物品栏"）。

                2026-10-16 第四轮（用户要求）：做成和「添加账号」一样的蒙板弹窗 —— 整块区域压一层
                黑 30% 的蒙板、卡片浮在正中，但蒙板**只盖第 1 行功能区到第 3 行命令栏**：
                左边一列的账号列表、第 0 行的连接参数（服务器 / 端口 / 用户名 / 版本 + 连接 / 断开）
                都不在蒙板里，面板开着时照样能切账号、能点断开（这两件事本来就会自动收起面板）。
                蒙板可见性绑在卡片上（卡片一直是代码在开合），不用在 C# 里多写一处同步。

                卡片内容仍然三行：标题固定、中间格子列表自己滚、状态行固定；格子按窗口快照动态铺
                （列数/行数由服务端容器类型决定；玩家背包按装备/背包/快捷栏分组，
                服务器窗口按"容器自己 + 物品栏"分两块，见 MCCX.Core 的 WindowBridgeBot）。
                MaxHeight 跟着日志区走：双层箱子 + 物品栏会比较高，超过就让面板内部滚动，
                而不是顶出蒙板把底部状态行裁掉（父容器是星号行，绑 ActualHeight 不会转圈）。
                服务器窗口的「关闭」发关窗口包给服务端；玩家背包是常驻窗口，关掉只表示"不再看"
                （不发关窗包）。服务端关窗、断开连接、切换账号都会自动收起。
                Esc 也能关：KeyboardAccelerator 不用抢焦点。
            -->
            <Grid x:Name="ContainerMask"
                  Grid.Row="1"
                  Grid.RowSpan="3"
                  Visibility="{Binding Visibility, ElementName=ContainerPanel}"
                  Background="{StaticResource ContainerMaskFill}">
                <Border x:Name="ContainerPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxHeight="{Binding ActualHeight, ElementName=LogAreaGrid}"
                        Padding="8"
                        CornerRadius="12"
                        UseLayoutRounding="True"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="容器窗口面板">
                    <Border.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Invoked="ContainerEscape_Invoked" />
                    </Border.KeyboardAccelerators>
                    <!--
                        内容分三行：标题固定、中间格子列表自己滚、状态行固定。
                        服务器窗口联动物品栏之后格子可能有一屏多（双层箱子 + 物品栏 = 10 行），
                        滚动的是格子；点格子时最要紧的那行（光标拿着什么）永远看得见。
                        装得下时不会有滚动条，观感与不加一样。
                    -->
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ContainerTitle"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ContainerSubtitle"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="ContainerCloseButton"
                                    Grid.Column="1"
                                    Content="关闭"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="关闭容器窗口"
                                    Click="ContainerCloseButton_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel x:Name="ContainerSlotStack" Spacing="6" />
                        </ScrollViewer>
                        <TextBlock x:Name="ContainerStatus"
                                   Grid.Row="2"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
