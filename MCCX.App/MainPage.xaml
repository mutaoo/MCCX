                                                       Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="84" />
